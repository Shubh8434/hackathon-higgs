# Copy this file to `.env` and paste your real key.
# Get a key at https://www.boson.ai/workspace/api-key  (format: bai-xxxx)
BOSON_API_KEY=bai-xxxx

# Optional overrides
PORT=3100
BOSON_API_BASE=https://api.boson.ai/v1

# Face image used to pre-render the 3 avatar clips (http(s) URL or local file path).
# You can also upload one from the UI ("Avatar clips" panel).
AVATAR_REF_IMAGE=
# TTS voice used for the avatar clips and the offline assistant voice.
ASSISTANT_VOICE=nora
